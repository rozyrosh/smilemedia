generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Media {
  id        String   @id @default(cuid())
  url       String   @db.Text
  filename  String   @db.VarChar(500)
  alt       String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now())

  designs        Design[]
  campaignSlides CampaignSlide[]
  heroSlides     HeroSlide[]
  webSites       WebSite[]
  services       Service[]
}

model SiteSettings {
  id               String   @id @default("main") @db.VarChar(64)
  heroEyebrow      String   @db.Text
  heroHeadline1    String   @db.VarChar(500)
  heroHeadline2    String   @db.VarChar(500)
  heroSub          String   @db.Text
  portfolioEyebrow String   @default("Creative Work") @db.VarChar(255)
  portfolioTitle   String   @default("OUR ARTISTRY") @db.VarChar(255)
  portfolioSub     String   @default("") @db.Text
  updatedAt        DateTime @updatedAt
}

model Service {
  id        String   @id @default(cuid())
  num       String   @db.VarChar(16)
  name      String   @db.VarChar(255)
  imageUrl  String   @db.Text
  mediaId   String?
  media     Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  itemsJson String   @default("[]") @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Design {
  id              String   @id @default(cuid())
  title           String   @db.VarChar(255)
  category        String   @default("Digital") @db.VarChar(64)
  imageUrl        String   @db.Text
  mediaId         String?
  media           Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  showInPortfolio Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CampaignSlide {
  id        String   @id @default(cuid())
  imageUrl  String   @db.Text
  mediaId   String?
  media     Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model HeroSlide {
  id         String   @id @default(cuid())
  titleLine1 String   @db.VarChar(255)
  titleLine2 String   @db.VarChar(255)
  imageUrl   String   @db.Text
  mediaId    String?
  media      Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model WebSite {
  id        String   @id @default(cuid())
  num       String   @db.VarChar(16)
  url       String   @db.VarChar(500)
  domain    String   @db.VarChar(255)
  tag       String   @db.VarChar(255)
  imageUrl  String   @db.Text
  mediaId   String?
  media     Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  desc      String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
